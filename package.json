{
  "name": "feishu-telegram-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "A configurable Feishu and Telegram bridge that executes Codex tasks on a local computer and follows the current CC Switch/Codex API configuration.",
  "main": "bridge.js",
  "scripts": {
    "start": "node bridge.js",
    "selftest": "node bridge.js --selftest",
    "model-check": "node bridge.js --model-check",
    "sync-rules": "node bridge.js --sync-rules",
    "security:scan": "node scripts/security-scan.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "codex",
    "feishu",
    "lark",
    "telegram",
    "remote-control",
    "cc-switch",
    "automation"
  ],
  "license": "MIT",
  "dependencies": {
    "undici": "^8.12.3"
  }
}
